# What must NOT reach the deployment.

# Resume, cover letters, outreach drafts. Nothing in the pipeline reads these.
output/

# The profile the scoring model reads.
#
# Excluded deliberately, even though the function needs it: builds from GitHub
# never see it either, because it is git-ignored. Shipping it on CLI deploys but
# not on git deploys would mean the two behave differently and only one of them
# gets tested. It travels as PROFILE_SUMMARY / PROFILE_RESUME / PROFILE_TARGETS
# instead — see lib/profile.ts and `pnpm profile:push`.
profile/

# The local SQLite working set, kept only as a backup of the original backfill.
# Neon is the live database.
data/

# Belt and braces: the gateway key, the Neon URL and CRON_SECRET live here.
# Vercel injects the real values from project settings.
.env
.env.*
