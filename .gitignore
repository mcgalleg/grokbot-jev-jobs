# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local job database
data/

# Personal documents. Deliberately untracked: git history is hard to scrub, and
# this repo may gain a remote later.
#   output/   CV, cover letters, outreach PDFs — nothing in the pipeline reads these
#   profile/  resume, targets and summary — live config that lib/jev reads on every
#             scoring call, and it carries the salary floor. See "Your profile" in
#             the README for what a fresh clone needs to recreate.
output/
profile/
