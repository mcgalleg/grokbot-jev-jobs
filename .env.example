# Neon (injected by the Vercel Marketplace integration; pull with `vercel env pull`)
DATABASE_URL=

# Cron (Vercel Cron sends Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=

# Local CLI only — the deployment uses VERCEL_OIDC_TOKEN instead
AI_GATEWAY_API_KEY=

# Resume Rudy: Apply → webhook → write-back
# Outbound POST to Rudy when you click Apply. Auth: Authorization: Bearer ${RUDY_APPLY_WEBHOOK_SECRET}
RUDY_APPLY_WEBHOOK_URL=
RUDY_APPLY_WEBHOOK_SECRET=
# Inbound POST /api/webhooks/rudy-apply. Auth: Authorization: Bearer … or x-rudy-secret
RUDY_CALLBACK_SECRET=
# Preferred public origin for callbackUrl in the webhook payload.
# Falls back to NEXT_PUBLIC_APP_URL, then https://$VERCEL_URL, then http://localhost:3000
APP_BASE_URL=
# Optional. When set, callbackUrl includes ?x-vercel-protection-bypass= so Rudy
# can reach a deployment behind Vercel Authentication without a session cookie.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Profile (optional locally; the deployment reads these instead of profile/*.md)
# PROFILE_SUMMARY=
# PROFILE_RESUME=
# PROFILE_TARGETS=
